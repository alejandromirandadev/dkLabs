{
  "version": 1,
  "name": "Hex Board",
  "layout": {
    "orientation": "flat-top",
    "origin": { "x": 640, "y": 360 }
  },
  "hex": {
    "sideLength": 50,
    "strokeWidth": 2,
    "outlineWidth3D": 3,
    "fillColor": "#5B5A42",
    "baseFillColor": "#5B5A42",
    "strokeColor": "#D0C48F",
    "textureFolder": "assets/images/hex_textures/",
    "textures": ["t1.png", "t2.png", "t3.png"],
    "textureRotationDeg": 0,
    "textureRepeat": [0.50, 0.50]
  },
  "nodes": {
    "radius": 7,
    "margin": 5,
    "fillColor": "#ffffff",
    "strokeColor": "#000000",
    "hoverColor": "#ffd54a"
  },
  "generate": {
    "type": "hex",
    "radius": 3
  }
}