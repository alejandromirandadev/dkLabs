{
  "version": 1,
  "name": "Hex Board",
  "layout": {
    "orientation": "flat-top",
    "origin": { "x": 640, "y": 360 }
  },
  "hex": {
    "sideLength": 50,
    "strokeWidth": 2,
    "fillColor": "#557D46",
    "baseFillColor": "#D0C48F",
    "strokeColor": "#0000ff"
  },
  "nodes": {
    "radius": 7,
    "margin": 5,
    "fillColor": "#ffffff",
    "strokeColor": "#000000",
    "hoverColor": "#ffd54a"
  },
  "generate": {
    "type": "hex",
    "radius": 3
  }
}